# Every key is parsed by apps/api/src/platform/config.ts — keep the two in sync.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16 (docker compose up -d). POSTGRES_PORT is read by docker-compose.yml.
POSTGRES_PORT=5432
DATABASE_URL=postgres://tg:tg@localhost:5432/tg
# Max connections in the pg pool, and how long a request waits for one before failing (ms).
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Public base URL of the web panel — used to build invitation and password-reset links (API + CLI)
PUBLIC_WEB_URL=http://localhost:5173
# Optional: path to the built web panel; unset in local development (API serves no static files)
# WEB_DIST_DIR=apps/web/dist

# Telegram bots (bot-connection)
# Public HTTPS base for the webhook URLs given to Telegram; unset = PUBLIC_WEB_URL (same origin).
# Telegram only delivers to HTTPS, so local webhook testing needs a tunnel URL here.
# TELEGRAM_WEBHOOK_BASE_URL=https://example.ngrok.app
# 32-byte AES-256-GCM key, base64, that encrypts stored bot tokens (ADR-0006). Required.
# Generate one with: openssl rand -base64 32 — the value below is for local development only.
BOT_TOKEN_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=
# max_connections given to setWebhook (1-100); must stay below DATABASE_POOL_MAX.
# Unset = 10, or DATABASE_POOL_MAX - 1 when the pool is smaller.
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=5
# Optional Bot API base URL; unset = Telegram's. Tests point it at a fake Bot API.
# TELEGRAM_API_ROOT=http://127.0.0.1:8081

# Web panel (Vite): base URL of the API server. Leave empty — the panel calls relative /api paths
# (same origin in production; Vite's dev server proxies /api to the API in development).
VITE_API_URL=
