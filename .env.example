# Every key is parsed by apps/api/src/platform/config.ts — keep the two in sync.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16 (docker compose up -d). POSTGRES_PORT is read by docker-compose.yml.
POSTGRES_PORT=5432
DATABASE_URL=postgres://tg:tg@localhost:5432/tg

# Web panel (Vite): base URL of the API server
VITE_API_URL=http://localhost:3000
