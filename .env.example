# Every key is parsed by apps/api/src/platform/config.ts — keep the two in sync.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16 (docker compose up -d). POSTGRES_PORT is read by docker-compose.yml.
POSTGRES_PORT=5432
DATABASE_URL=postgres://tg:tg@localhost:5432/tg

# Public base URL of the web panel — used to build invitation and password-reset links (API + CLI)
PUBLIC_WEB_URL=http://localhost:5173
# Optional: path to the built web panel; unset in local development (API serves no static files)
# WEB_DIST_DIR=apps/web/dist

# Web panel (Vite): base URL of the API server
VITE_API_URL=http://localhost:3000
