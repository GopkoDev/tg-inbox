{
  "name": "@tg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:new": "kysely migrate:make",
    "db:migrate": "kysely migrate:latest",
    "db:rollback": "kysely migrate:down",
    "db:codegen": "kysely-codegen --dialect postgres --env-file ../../.env --include-pattern 'public.*' --exclude-pattern 'public.kysely_*' --out-file src/platform/db.types.gen.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/websocket": "^11.3.4",
    "@tg/shared": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "grammy": "^1.46.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino-pretty": "^13.2.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "tsx": "^4.23.15"
  }
}
